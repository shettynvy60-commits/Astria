# Astria Backend Environment Configuration
# ==========================================

# LLM Providers (Provide at least one, or leave blank to use the built-in intelligent pedagogical generator)
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenAI Whisper - For AI Voice Interviewer Speech-to-Text (Section 5)
# Used at: POST /api/interview/transcribe
WHISPER_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Presidio & spaCy - Local PII Scrubbing Engine
SPACY_MODEL=en_core_web_sm

# Session Security - PII Vault encryption key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=

# GitHub Deployment
# GITHUB_PAGES_URL=https://yourusername.github.io/astria
